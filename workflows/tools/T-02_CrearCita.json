    {
      "parameters": {
        "jsCode": "const input = $('Tool Trigger: Crear Cita').first().json;\n\n// Obtener fecha actual forzada en America/Bogota con Intl\nconst formatterBogota = new Intl.DateTimeFormat('en-US', {\n  timeZone: 'America/Bogota',\n  year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n});\nconst parts = formatterBogota.formatToParts(new Date());\nconst p = {};\nparts.forEach(({ type, value }) => { p[type] = value; });\nconst anioActual = parseInt(p.year);\nconst hoyBogotaStr = `${p.year}-${p.month}-${p.day}`;\n\nfunction parsearFechaColombia(raw) {\n  if (!raw || typeof raw !== 'string') return null;\n  const str = raw.trim();\n\n  // 1. Si viene con 'Z' o offset explícito, parsear en UTC y convertir con exactitud a Bogotá\n  if (/Z|[+-]\\d{2}:\\d{2}$/i.test(str)) {\n    const d = new Date(str);\n    if (isNaN(d.getTime())) return null;\n    const bogotaIso = d.toLocaleDateString('sv-SE', { timeZone: 'America/Bogota' }) + 'T' +\n                      d.toLocaleTimeString('sv-SE', { timeZone: 'America/Bogota' });\n    return bogotaIso + '-05:00';\n  }\n\n  // 2. Formato ISO local sin zona (YYYY-MM-DDTHH:mm...)\n  const isoMatch = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})[T ](\\d{1,2}):(\\d{2})/);\n  if (isoMatch) {\n    const [, y, m, d, hh, mm] = isoMatch;\n    const year = Math.max(parseInt(y), anioActual);\n    \n    // Validación anti-rollover (ej. 30 de febrero o 31 de abril)\n    const checkDate = new Date(Date.UTC(year, parseInt(m) - 1, parseInt(d)));\n    if (checkDate.getUTCDate() !== parseInt(d) || checkDate.getUTCMonth() !== (parseInt(m) - 1)) {\n      return null; // Fecha inexistente en calendario\n    }\n    return `${year}-${m}-${d}T${hh.padStart(2, '0')}:${mm}:00-05:00`;\n  }\n\n  // 3. Lenguaje natural básico: 'mañana a las 3', 'hoy 3:30 pm'\n  let targetDate = new Date(`${hoyBogotaStr}T12:00:00-05:00`);\n  if (/mañana/i.test(str)) {\n    targetDate.setDate(targetDate.getDate() + 1);\n  }\n\n  const timeMatch = str.match(/(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm|a\\.m\\.|p\\.m\\.)?/i);\n  if (!timeMatch) return null;\n\n  let h = parseInt(timeMatch[1]);\n  const min = timeMatch[2] ? parseInt(timeMatch[2]) : 0;\n  const mer = timeMatch[3] ? timeMatch[3].toLowerCase().replace(/\\./g, '') : '';\n  if (mer === 'pm' && h < 12) h += 12;\n  if (mer === 'am' && h === 12) h = 0;\n  if (!mer && h >= 1 && h <= 8) h += 12; // En un salón, de 1 a 8 son de la tarde (13:00 a 20:00)\n  if (h > 23 || min > 59) return null;\n\n  const y = targetDate.getFullYear();\n  const mo = String(targetDate.getMonth() + 1).padStart(2, '0');\n  const da = String(targetDate.getDate()).padStart(2, '0');\n  return `${y}-${mo}-${da}T${String(h).padStart(2, '0')}:${String(min).padStart(2, '0')}:00-05:00`;\n}\n\nconst iso = parsearFechaColombia(input.fecha_hora);\nconst fechaInicio = iso ? new Date(iso) : null;\nconst valida = fechaInicio && !isNaN(fechaInicio.getTime());\n\nreturn [{\n  json: {\n    wa_id: (input.wa_id || '').toString().trim(),\n    nombre_cliente: (input.nombre_cliente || 'Cliente').trim(),\n    servicio: (input.servicio || '').trim(),\n    fecha_inicio: valida ? fechaInicio.toISOString() : '1970-01-01T00:00:00.000Z'\n  }\n}];\n"
      },
