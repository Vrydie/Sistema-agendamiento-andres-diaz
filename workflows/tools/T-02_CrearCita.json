            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Horario Libre?": {
      "main": [
        [
          {
            "node": "DB: Guardar Cita Confirmada",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respuesta Conflicto Horario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DB: Guardar Cita Confirmada": {
      "main": [
