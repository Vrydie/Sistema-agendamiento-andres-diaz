      "parameters": {
        "jsCode": "const input = $('Tool Trigger: Crear Cita').first().json;\nconst servicio = $input.first().json;\n\nfunction parsearFechaColombia(raw) {\n  const ahora = new Date();\n  const bogotaOffset = -5 * 60;\n  const nowBogota = new Date(ahora.getTime() + (ahora.getTimezoneOffset() + bogotaOffset) * 60000);\n  \n  if (!raw || typeof raw !== 'string') return new Date();\n\n  let str = raw.trim();\n\n  // 1. Si viene en formato ISO (YYYY-MM-DDTHH:mm...)\n  const isoMatch = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})[T ](\\d{1,2}):(\\d{2})(?::(\\d{2}))?(.*)$/);\n  if (isoMatch) {\n    let [_, y, m, d, hh, mm, ss, tz] = isoMatch;\n    let year = parseInt(y);\n    if (year < 2026) year = 2026;\n    if (!tz || tz.trim() === '') tz = '-05:00';\n    return new Date(year + '-' + m + '-' + d + 'T' + hh.padStart(2, '0') + ':' + mm + ':00' + tz);\n  }\n\n  // 2. Si viene en lenguaje natural ej: 'mañana a las 3', 'mañana a las 3:00 PM'\n  let targetDate = new Date(nowBogota);\n  if (/mañana/i.test(str)) {\n    targetDate.setDate(targetDate.getDate() + 1);\n  }\n\n  let hora = 15; // default 3:00 PM si no se especifica\n  let minutos = 0;\n\n  const timeMatch = str.match(/(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm|a\\.m\\.|p\\.m\\.)?/i);\n  if (timeMatch) {\n    let h = parseInt(timeMatch[1]);\n    let m = timeMatch[2] ? parseInt(timeMatch[2]) : 0;\n    let mer = timeMatch[3] ? timeMatch[3].toLowerCase().replace(/\\./g, '') : '';\n\n    if (mer === 'pm' && h < 12) h += 12;\n    if (mer === 'am' && h === 12) h = 0;\n    if (!mer && h >= 1 && h <= 7) h += 12; // En salón de belleza, 'las 3' son las 15:00\n\n    hora = h;\n    minutos = m;\n  }\n\n  const y = 2026;\n  const m = String(targetDate.getMonth() + 1).padStart(2, '0');\n  const d = String(targetDate.getDate()).padStart(2, '0');\n  const hh = String(hora).padStart(2, '0');\n  const mm = String(minutos).padStart(2, '0');\n\n  return new Date(y + '-' + m + '-' + d + 'T' + hh + ':' + mm + ':00-05:00');\n}\n\nconst fechaInicio = parsearFechaColombia(input.fecha_hora);\nconst duracionMs = (servicio.duracion_minutos || 60) * 60 * 1000;\nconst fechaFin = new Date(fechaInicio.getTime() + duracionMs);\n\nreturn [{\n  json: {\n    wa_id: (input.wa_id || '').trim(),\n    nombre_cliente: (input.nombre_cliente || 'Cliente').trim(),\n    servicio_id: servicio.id,\n    nombre_servicio: servicio.nombre,\n    precio: servicio.precio_base_cop,\n    fecha_inicio: fechaInicio.toISOString(),\n    fecha_fin: fechaFin.toISOString(),\n    fecha_cita_formateada: fechaInicio.toLocaleString('es-CO', { timeZone: 'America/Bogota' })\n  }\n}];\n\n"
      },
