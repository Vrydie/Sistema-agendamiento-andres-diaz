    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst codigo = r.out_codigo || 'ERROR_TECNICO';\n\nconst fmt = (d) => new Date(d).toLocaleString('es-CO', {\n  weekday: 'long', day: 'numeric', month: 'long',\n  hour: 'numeric', minute: '2-digit', hour12: true,\n  timeZone: 'America/Bogota'\n});\n\nlet salida;\n\nif (codigo === 'YA_EXISTIA') {\n  salida = {\n    exito: true,\n    codigo,\n    cita_id: r.out_cita_id,\n    mensaje_para_cliente: `Tu cita para ${r.out_servicio_nombre} ya estaba confirmada para el ${fmt(r.out_fecha_inicio)}. Te esperamos en Cra 83 # 09.`,\n    instruccion_agente: 'La cita YA está registrada. Comunícalo al cliente. NO vuelvas a llamar agendar_cita.'\n  };\n} else if (codigo === 'HORARIO_OCUPADO') {\n  salida = {\n    exito: false,\n    codigo,\n    alternativas_libres: r.out_alternativas || '',\n    mensaje_para_cliente: r.out_mensaje,\n    instruccion_agente: 'Ese horario SÍ está ocupado en la agenda. Ofrece SOLO las alternativas_libres. NO reintentes con la misma hora.'\n  };\n} else if (codigo === 'ERROR_TECNICO') {\n  salida = {\n    exito: false,\n    codigo,\n    mensaje_para_cliente: 'Tuvimos un inconveniente técnico al registrar tu cita, pero ya avisamos a Andrés para que la confirme contigo personalmente.',\n    instruccion_agente: 'FALLO TÉCNICO, no es un conflicto de horario. NUNCA digas que el horario está ocupado. Llama escalar_humano y comunica mensaje_para_cliente.'\n  };\n} else {\n  salida = {\n    exito: false,\n    codigo,\n    mensaje_para_cliente: r.out_mensaje,\n    instruccion_agente: 'Explica el problema al cliente con naturalidad y pídele el dato correcto. NO repitas la misma llamada sin cambiar los datos.'\n  };\n}\n\nreturn [{ json: salida }];\n"
      },
