      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversaciones c\nSET estado = 'pausada_humano', pausada_hasta = CURRENT_TIMESTAMP + INTERVAL '4 hours'\nFROM clientes cl\nWHERE c.cliente_id = cl.id \n  AND regexp_replace(cl.wa_id, '\\D', '', 'g') = regexp_replace($1, '\\D', '', 'g') \n  AND c.estado = 'activa'\nRETURNING c.id;",
        "options": {
          "queryReplacement": "={{ [$json.wa_id] }}"
        }
      },
