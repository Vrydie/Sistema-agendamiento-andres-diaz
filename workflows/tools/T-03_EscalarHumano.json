        "postgres": {
          "id": "EppjWtl0P6ZXP0fh",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const triggerData = $('Tool Trigger: Escalar a Humano').first().json;\nconst motivo = triggerData.motivo || 'Solicitud de atención personalizada';\nconst wa_id = (triggerData.wa_id || '').toString().replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    exito: true,\n    wa_id: wa_id,\n    motivo: motivo\n  }\n}];"
      },
