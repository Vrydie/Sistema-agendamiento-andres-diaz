        "operation": "executeQuery",
        "query": "SELECT c.id AS conversacion_id, c.estado, c.cliente_id\nFROM conversaciones c\nJOIN clientes cl ON cl.id = c.cliente_id\nWHERE cl.wa_id = $1\nORDER BY c.ultimo_mensaje_en DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.wa_id] }}"
        }
