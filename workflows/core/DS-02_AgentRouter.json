    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM mensajes \nWHERE conversacion_id IN (\n    SELECT c.id FROM conversaciones c\n    JOIN clientes cl ON cl.id = c.cliente_id\n    WHERE cl.wa_id = $1\n);\n\nUPDATE conversaciones \nSET estado = 'cerrada', ultimo_mensaje_en = CURRENT_TIMESTAMP \nWHERE cliente_id IN (\n    SELECT id FROM clientes WHERE wa_id = $1\n);\n\nUPDATE clientes \nSET nombre = 'Cliente' \nWHERE wa_id = $1;\n\nSELECT 'ok' AS status;",
        "options": {
          "queryReplacement": "={{ [$('Trigger: Mensaje Consolidado').first().json.wa_id] }}"
        }
      },
