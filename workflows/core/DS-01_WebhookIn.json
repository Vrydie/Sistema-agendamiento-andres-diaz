      "position": [
        -240,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// 1. Manejo de YCloud (whatsapp.inbound_message)\nif (body.type === 'whatsapp.inbound_message.received' || body.whatsappInboundMessage || body.type?.startsWith('whatsapp.inbound_message')) {\n  const msg = body.whatsappInboundMessage || body;\n  const texto = msg.text?.body || msg.body || '';\n  const from = msg.from || msg.sender;\n  const nombre = msg.profile?.name || msg.customerName || 'Cliente';\n  \n  if (!texto) {\n    return []; // Ignorar si no es texto\n  }\n  \n  return [{\n    json: {\n      wa_id: from,\n      nombre: nombre,\n      texto: texto.trim(),\n      es_texto: true,\n      mensaje_id: msg.id || 'ycloud_' + Date.now(),\n      raw_payload: body\n    }\n  }];\n}\n\n// 2. Manejo de Meta estándar\nconst entry = body.entry?.[0]?.changes?.[0]?.value;\nif (entry?.messages && entry.messages.length > 0) {\n  const msg = entry.messages[0];\n  const contact = entry.contacts?.[0] || {};\n  return [{\n    json: {\n      wa_id: msg.from,\n      nombre: contact.profile?.name || 'Cliente',\n      texto: (msg.text?.body || '').trim(),\n      es_texto: msg.type === 'text',\n      mensaje_id: msg.id,\n      raw_payload: body\n    }\n  }];\n}\n\nreturn [];\n\n"
      },
