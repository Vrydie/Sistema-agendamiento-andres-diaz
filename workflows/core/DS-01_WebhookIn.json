        "query": "INSERT INTO eventos_webhook (origen, payload_raw) VALUES ('meta_whatsapp', $1::jsonb);\n\nINSERT INTO cola_mensajes_debounce (wa_id, mensaje_id_externo, texto)\nVALUES ($2, $3, $4);\n\nSELECT * FROM obtener_o_crear_cliente($2, $5);",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.raw_payload), $json.wa_id, $json.mensaje_id, $json.texto, $json.nombre] }}"
